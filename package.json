{
  "//": "Workflow toolchain for forgekit-ios. OpenSpec and CodeGraph are npm packages, so node is this workflow's own runtime — it is not here because the product is JavaScript.",
  "name": "forgekit-ios-workflow",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.16",
    "pnpm": ">=11"
  },
  "forgekit": {
    "sourceGlobs": [
      "*.swift"
    ],
    "requiredTools": [
      "tuist",
      "xcodebuild"
    ],
    "nodeSubprojects": []
  },
  "scripts": {
    "preflight": "bash scripts/preflight.sh",
    "sync-workflow": "bash scripts/sync-workflow.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.5.0",
    "@fission-ai/openspec": "^1.9.0",
    "grillme": "latest"
  }
}
